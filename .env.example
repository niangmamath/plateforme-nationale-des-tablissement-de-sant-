# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Postgres local (Docker) ---
# Port 5432 par défaut est déjà occupé par un autre projet local -> on utilise 5433.
POSTGRES_USER="medimplant"
POSTGRES_PASSWORD="medimplant"
POSTGRES_DB="medimplant"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://medimplant:medimplant@localhost:5433/medimplant"

# --- Directus (CMS admin local, Docker) ---
DIRECTUS_PORT="8055"
DIRECTUS_KEY="MY_DIRECTUS_KEY"
DIRECTUS_SECRET="MY_DIRECTUS_SECRET"
DIRECTUS_ADMIN_EMAIL="admin@medimplant.app"
DIRECTUS_ADMIN_PASSWORD="MY_DIRECTUS_ADMIN_PASSWORD"
