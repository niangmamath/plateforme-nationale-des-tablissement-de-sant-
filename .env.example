# Assistant du chatbot (server/chat.ts) : au moins UNE des deux clés est requise.
# OPENAI_API_KEY est prioritaire quand les deux sont définies (le quota gratuit de Gemini,
# 20 requêtes/jour, ne suffit pas pour un vrai usage). OPENAI_MODEL est optionnel (défaut gpt-4.1-mini).
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# OPENAI_MODEL="gpt-4.1-mini"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Postgres local (Docker) ---
# Port 5432 par défaut est déjà occupé par un autre projet local -> on utilise 5433.
POSTGRES_USER="medimplant"
POSTGRES_PASSWORD="medimplant"
POSTGRES_DB="medimplant"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://medimplant:medimplant@localhost:5433/medimplant"

# --- Directus (CMS admin local, Docker) ---
DIRECTUS_PORT="8055"
DIRECTUS_KEY="MY_DIRECTUS_KEY"
DIRECTUS_SECRET="MY_DIRECTUS_SECRET"
DIRECTUS_ADMIN_EMAIL="admin@medimplant.app"
DIRECTUS_ADMIN_PASSWORD="MY_DIRECTUS_ADMIN_PASSWORD"
